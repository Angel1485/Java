<!--        <encoder>-->
<!--            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>-->
<!--        </encoder>-->
<!--    </appender>-->

    <!-- Nivel global -->
    <root level="info">
        <appender-ref ref="CONSOLA" />
<!--        <appender-ref ref="ARCHIVO" />-->
    </root>

</configuration>